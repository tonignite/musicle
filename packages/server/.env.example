# Musicle server config — copy to .env and fill in.
PORT=3000
HOST=0.0.0.0

# Spotify OAuth (create an app at https://developer.spotify.com/dashboard).
# Register the redirect URI below in the app's settings, exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify rejects "localhost" — use the loopback IP 127.0.0.1 (or HTTPS).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Tidal OAuth (create an app at https://developer.tidal.com). Uses Authorization
# Code + PKCE; register the redirect URI below in the app's settings, exactly.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=http://127.0.0.1:3000/auth/tidal/callback
# Country code for region-scoped collection reads (ISO 3166-1 alpha-2).
TIDAL_COUNTRY_CODE=US

# Tracks to pull + preview-match per player.
LIBRARY_TARGET_SIZE=120

# Where to send the browser after linking. For the Flutter app this is a
# custom-scheme deep link, e.g. musicle://linked. Leave empty to show a plain
# HTML success page (handy for backend-only testing).
APP_RETURN_URL=
